.bg {
    flex-grow: 1;
    
    align-items: center;
    justify-content: center;
}


.window {
    flex-direction: row;
    
    align-items: center;
    justify-content: space-around;
    
    width: 65%;
    height: 65%;
    
    background-image: url("project://database/Assets/UI/UIAssets/Backgrounds/UpgradesBackground.png");
    
    border-width: 10px;
}


.header {
    width: 35%;
    height: 15%;
    
    position: absolute;
    top: -7.5%;
    left: 32.5%;
    
    border-width: 15px;
    border-radius: 50px;
    
    -unity-font-style: bold;
    
    -unity-text-align: middle-center;
}


.cards-container {
    flex-direction: row;
    
    align-items: center;
    justify-content: space-around;
    
    width: 75%;
    height: 75%;
}

.card {
    align-items: center;
    justify-content: space-around;
    
    width: 25%;
    height: 80%;
    
    border-width: 10px;
    border-radius: 15px;
    
    transition: background-color 0.2s ease, scale 0.2s ease;
}

.card--lower {
    top: 5%;
}

.card-text {
    white-space: normal;
    
    -unity-text-align: middle-center;
}
 
.card:hover {
    scale: 1.1;
}


.close-button {
    position: absolute;
    top: 25px;
    right: 25px;
}

.rotate-button {
    width: 60px;
    height: 100px;
}