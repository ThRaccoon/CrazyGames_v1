.bg {
    flex-grow: 1;
    flex-direction: row;
    
    background-image: url("project://database/Assets/UI/UIAssets/Backgrounds/MainMenuBackground.png");
}


.panel {
    width: 33.3333%;
    height: 100%;
}

.panel--left { flex-direction: column; justify-content: space-between; }
.panel--middle { align-items: center; justify-content: center; }
.panel--right { align-items: flex-end; }


.wheel-button {
    top: 35px;
    left: 35px;
}

.options-button {
    left: 35px;
    bottom: 35px;
}


.rectangle-buttons-container {
    align-items: stretch;
    justify-content: space-around;
    width: 50%;
    height: 50%;
}


.currencies-container {
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    height: 16%;
}

.currency-box {
    align-items: center;
    justify-content: space-around;
    
    width: 40%;
    height: 55%;
    
    border-width: 10px;
}