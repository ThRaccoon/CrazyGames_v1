.c-button, .c-toggle {
    border-width: 10px;
    border-radius: 15px;
    font-size: 50px;
    -unity-font-style: bold;
    transition: background-color 0.2s ease, scale 0.2s ease;
}

.c-button--square {
    width: 75px;
    height: 75px;
}

.c-button:hover {
    background-color: rgb(220, 200, 180);
    scale: 1.1;
}