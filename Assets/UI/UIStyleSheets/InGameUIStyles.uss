.bg {
    flex-grow: 1;
    flex-direction: row;
}


.panel {
    width: 33.3333%;
    height: 100%;
}

.panel--left { justify-content: space-between; }
.panel--middle { align-items: center; justify-content: center; }
.panel--right { align-items: flex-end; }


.character-status-container {
    flex-direction: row-reverse;
    
    align-items: center;
    justify-content: flex-end;
    
    width: 100%;
    
    margin-top: 35px;
    margin-left: 35px;
}

.lvl-box {
    align-items: center;
    justify-content: center;
    
    width: 150px;
    height: 150px;
    
    border-width: 10px;
    border-radius: 100px;
}

.status-bars-container {
    width: 50%;
    height: 50%;
    
    top: 5%;
    right: 4%;
}

.bar-box-hp {
    width: 100%;
    height: 50%;
    
    background-color: rgb(120, 30, 30);
}

.bar-box-xp {
    width: 85%;
    height: 40%;
    
    background-color: rgb(75, 20, 80);
}

.bar-box--brd-left-large {
    border-width: 5px 5px 5px 35px;
}

.bar-fill {
    width: 75%;
    height: 100%;
}

.bar-fill--hp { background-color: rgb(230, 50, 50); }
.bar-fill--xp { background-color: rgb(155, 40, 175); }


.buffs-box {
    justify-content: flex-start;
    
    width: 40%;
    height: 35%;
    
    margin-left: 35px;
    
    border-width: 10px;
}


.options-button {
    left: 35px;
    bottom: 35px;
}


.currencies-container {
    flex-direction: row-reverse;
    
    align-items: center;
    justify-content: space-around;
    
    width: 100%;
    height: 16%;
}

.currency-box {
    align-items: center;
    justify-content: space-around;
    
    width: 40%;
    height: 55%;
    
    border-width: 10px;
}


.score-box {
    justify-content: space-around;
    
    width: 40%;
    height: 30%;
    
    margin-top: 35px;
    margin-right: 35px;

    border-width: 10px;
}

.score-field {
    flex-direction: row;
}